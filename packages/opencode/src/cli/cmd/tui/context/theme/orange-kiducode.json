{
  "$schema": "https://opencode.ai/theme.json",
  "defs": {
    "black": "#050505",
    "white": "#edf2ff",
    "brand": "#ff7500",
    "brandWarm": "#ffa555",
    "brandSoft": "#ffcf99",
    "red": "#f52a65",
    "orange": "#ffa555",
    "cyan": "#ff7500",
    "grey": "#8a8a8a"
  },
  "theme": {
    "primary": { "dark": "brand", "light": "brand" },
    "secondary": { "dark": "cyan", "light": "cyan" },
    "accent": { "dark": "brandWarm", "light": "brandWarm" },
    "error": { "dark": "red", "light": "red" },
    "warning": { "dark": "orange", "light": "orange" },
    "success": { "dark": "brandSoft", "light": "brandSoft" },
    "info": { "dark": "cyan", "light": "cyan" },
    "text": { "dark": "white", "light": "white" },
    "textMuted": { "dark": "grey", "light": "grey" },
    "background": { "dark": "black", "light": "black" },
    "backgroundPanel": { "dark": "#0a0a0a", "light": "#0a0a0a" },
    "backgroundElement": { "dark": "#141414", "light": "#141414" },
    "border": { "dark": "grey", "light": "grey" },
    "borderActive": { "dark": "white", "light": "white" },
    "borderSubtle": { "dark": "#282828", "light": "#282828" },
    "diffAdded": { "dark": "#4fd6be", "light": "#4fd6be" },
    "diffRemoved": { "dark": "#c53b53", "light": "#c53b53" },
    "diffContext": { "dark": "#828bb8", "light": "#828bb8" },
    "diffHunkHeader": { "dark": "#828bb8", "light": "#828bb8" },
    "diffHighlightAdded": { "dark": "#b8db87", "light": "#b8db87" },
    "diffHighlightRemoved": { "dark": "#e26a75", "light": "#e26a75" },
    "diffAddedBg": { "dark": "#20303b", "light": "#20303b" },
    "diffRemovedBg": { "dark": "#37222c", "light": "#37222c" },
    "diffContextBg": { "dark": "#141414", "light": "#141414" },
    "diffLineNumber": { "dark": "#8f8f8f", "light": "#8f8f8f" },
    "diffAddedLineNumberBg": { "dark": "#1b2b34", "light": "#1b2b34" },
    "diffRemovedLineNumberBg": { "dark": "#2d1f26", "light": "#2d1f26" },
    "markdownText": { "dark": "white", "light": "white" },
    "markdownHeading": { "dark": "brandWarm", "light": "brandWarm" },
    "markdownLink": { "dark": "brand", "light": "brand" },
    "markdownLinkText": { "dark": "cyan", "light": "cyan" },
    "markdownCode": { "dark": "brandSoft", "light": "brandSoft" },
    "markdownBlockQuote": { "dark": "brandWarm", "light": "brandWarm" },
    "markdownEmph": { "dark": "brandWarm", "light": "brandWarm" },
    "markdownStrong": { "dark": "orange", "light": "orange" },
    "markdownHorizontalRule": { "dark": "grey", "light": "grey" },
    "markdownListItem": { "dark": "brand", "light": "brand" },
    "markdownListEnumeration": { "dark": "cyan", "light": "cyan" },
    "markdownImage": { "dark": "brand", "light": "brand" },
    "markdownImageText": { "dark": "cyan", "light": "cyan" },
    "markdownCodeBlock": { "dark": "black", "light": "black" },
    "syntaxComment": { "dark": "grey", "light": "grey" },
    "syntaxKeyword": { "dark": "brandWarm", "light": "brandWarm" },
    "syntaxFunction": { "dark": "brand", "light": "brand" },
    "syntaxVariable": { "dark": "red", "light": "red" },
    "syntaxString": { "dark": "brandSoft", "light": "brandSoft" },
    "syntaxNumber": { "dark": "orange", "light": "orange" },
    "syntaxType": { "dark": "brandWarm", "light": "brandWarm" },
    "syntaxOperator": { "dark": "cyan", "light": "cyan" },
    "syntaxPunctuation": { "dark": "white", "light": "white" }
